fn fetch(t: texture_2d<f32>, p: vec2i) -> vec4f {
  if (any(p < vec2i(0)) || any(p >= vec2i(textureDimensions(t)))) {
    return vec4f(0.0);
  }
  return textureLoad(t, p, 0);
}

